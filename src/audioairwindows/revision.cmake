# Writes audioairwindows_revision.h: which commit a firmware was built from.
#
#   cmake -DMOD_DIR=<this repository> -DOUT=<header> -P revision.cmake
#
# micropython.cmake runs this on every build. The string is the one
# micropython.mk computes.
#
# SPDX-License-Identifier: MIT

execute_process(
    COMMAND git -C ${MOD_DIR} describe --tags --match v[0-9]* --always --dirty --abbrev=7
    OUTPUT_VARIABLE REVISION
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE RESULT
    ERROR_QUIET)
if(NOT RESULT EQUAL 0 OR NOT REVISION)
    set(REVISION "unknown")
endif()

set(CONTENT "// Generated by revision.cmake. Do not edit.\n#define AW_REVISION \"${REVISION}\"\n")
set(OLD "")
if(EXISTS ${OUT})
    file(READ ${OUT} OLD)
endif()
if(NOT OLD STREQUAL CONTENT)
    file(WRITE ${OUT} "${CONTENT}")
endif()
